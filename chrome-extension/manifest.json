{
  "manifest_version": 3,
  "name": "PokéSurvivor Mod Menu & Unlocker",
  "version": "1.1",
  "description": "Menu de Mods para PokeSurvivor: Modo Deus, Vida Customizada, Dano Multiplicado, Pokémons, Shinies e Moedas.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pokesurvivor.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
